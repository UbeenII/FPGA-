`timescale 1ns / 100ps
module reaction #(
	parameter WIDTH=16
)(
 input logic clk,
 input logic rst,
 input logic time_out,
 input logic key,
 output logic [WIDTH- 1:0] count
 );
	always_ff @ (posedge clk or posedge rst)
		if(time_out) count<= {WIDTH{1'b0}};
		else begin
			count <= count + {{WIDTH - 1{1'b0}}, key};
		end		
endmodule