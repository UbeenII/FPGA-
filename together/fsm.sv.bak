module fsm (
	input logic clk,
	input logic tick,
	input trigger,
	input time_out,
	input tick,
	output start_delay,
	output [9:0] ledr

); 
logic [3:0]  count;
logic [9:0] led
type enum {IDLE, LED,TIMEOUT} my_state;
	my_state current_state, next_state;
	
always_comb 
	case (current_state)
		IDLE: if(trigger) next_state = LED;
				else next_state = current_state;
		LED: if(count >= 9) next_state = TIME_OUT;
				else next_state = current_state;
		TIMEOUT: if(time_out =1) next_state = IDLE;
					 else next_state= current_state;
		default: next_state =IDLE; 

always_ff @(tick && current_state = LED)
	led = ~(9'b111111111>> count)
	count = count+1;
	
always_comb 
	case (current_state)
		IDLE: ledr = 9'b0;
		LED : ledr = led
				if ( ledr = 9'b111111111) assign start_delay =1;
		TIMEOUT : ledr = 9'b1;
		default: ledr = 9'b0;
	endcase
		

	