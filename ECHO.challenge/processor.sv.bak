module processor(
	input logic [9:0] sw,
	input logic clk,
	input  logic [9:0] data_in,
	output logic [6:0]hex0,hex1,hex2,
	output logic [9:0] data_out,
	input logic data_valid
		
);
logic BCD0,BCD1,BCD2,BCD3,BCD;
logic [19:0] delay;
logic [12:0] wdaddr,rdaddr;
logic enable;

assign switch = {sw,3b'0};
delay = sw *819;
bin2bcd BIN(.BCD0(BCD0),.BCD1(BCD1),.BCD2(BCD2),.x({2'b0,delay[19:10]});
hexto7seg SEG0(.out(hex0),
							.in(BCD0)
							);
							
hexto7seg SEG1(.out(hex1),
							.in(BCD1)
							);
				
hexto7seg SEG2(.out(hex2),
							.in(BCD2)
							);
							
ncounter #(parameter WIDTH =13)(
	.clk(~data_valid),
	.rst(0),
	.en(1),
	.n(9b'1),
	.count(rdaddr)
);	
assign wdaddr = switch + rdaddr;
pulse_gen  PULSE (.clk(clk), .rst(1'b0), .in(data_valid), .pulse(enable));]

ram (.wren(enable),
		.rden(enable),
		.wraddress(wdaddr),
		.rdaddress(rdaddr),
		.data(y),
		.clock(clk),
		.q(q)
	  );



			
							




